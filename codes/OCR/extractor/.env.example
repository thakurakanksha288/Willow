# Willow Food Safety Backend Configuration

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model for analysis layer (e.g. gemini-3.5-flash-lite)
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite

# Gemini Request Timeout (seconds)
GEMINI_REQUEST_TIMEOUT=30.0

# Maximum retry attempts for transient API errors (e.g. rate limits or network glitches)
GEMINI_MAX_RETRIES=3

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Backend Server Port
PORT=5000

