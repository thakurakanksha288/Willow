        <mxCell id="note1" value="&lt;b&gt;Deployment assumptions&lt;/b&gt;&lt;br&gt;This is a technology-neutral deployment view based on the supplied Willow class and sequence diagrams. Specific framework, cloud host, database product and OCR vendor are intentionally not guessed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=9;fontSize=12;fillColor=#FFFBEA;strokeColor=#D8B85A;fontColor=#5B4A1B;" vertex="1" parent="1">
          <mxGeometry x="55" y="875" width="650" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Runtime flow&lt;/b&gt;&lt;br&gt;1. User uploads an image or enters ingredients.&lt;br&gt;2. Willow validates and processes the request.&lt;br&gt;3. OCR provider returns extracted text when needed.&lt;br&gt;4. Backend queries the database for aliases, category risk profiles and alternatives.&lt;br&gt;5. Willow returns the analysis to the user." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=9;fontSize=12;fillColor=#FFFBEA;strokeColor=#D8B85A;fontColor=#5B4A1B;" vertex="1" parent="1">
          <mxGeometry x="760" y="875" width="640" height="90" as="geometry" />
